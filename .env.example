# Celesto Provider: 'local' (open-source runtime) or 'cloud' (Celesto Cloud)
CELESTO_PROVIDER=local

# Celesto Cloud API Key (required only if CELESTO_PROVIDER=cloud)
CELESTO_API_KEY=replace-me

# Celesto Backend (local runtime only): 'firecracker' or 'qemu'
CELESTO_BACKEND=firecracker

# LLM Configuration (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql://ledger:ledger@ledger:5432/ledger

# API Server
API_PORT=8080

# Agent Configuration
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SECONDS=300
SANDBOX_CPU=1
SANDBOX_MEMORY_GB=2
SANDBOX_DISK_GB=10

# Network Policy for containment (off, allowlist, denylist)
SANDBOX_NETWORK_MODE=off

# Snapshot Configuration
SNAPSHOT_ENABLED=true
SNAPSHOT_BEFORE_RISKY_STEP=true

# Safety Hooks
SAFETY_HOOKS_ENABLED=true
BLOCK_DESTRUCTIVE_COMMANDS=true

# Concurrency
MAX_CONCURRENT_SANDBOXES=5